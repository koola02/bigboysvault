# Copy to ops/env and fill in. Never commit ops/env (it's in .gitignore).
SITE=https://www.bigboysvault.com
# The owner's admin password (fly secrets list -a bigboysvault shows it's set; the value is yours).
ADMIN_TOKEN=
FLY_APP=bigboysvault
# For ops/images.sh and ops/deploy.sh: fly tokens create deploy -a bigboysvault
FLY_API_TOKEN=
# Where copies live on this VM.
DATA_DIR=/home/YOUR_USER/bbv
# A bucket for copies off the VM (make it once: gcloud storage buckets create gs://bbv-backups-XXXX --location=asia-southeast1)
GCS_BUCKET=
# Alerts from the uptime watcher: a Telegram bot (talk to @BotFather, then get your chat id from @userinfobot)…
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# …or a Discord/Slack-style webhook.
ALERT_WEBHOOK=
# Repo checkout for deploy.sh and staging.sh
REPO_DIR=/home/YOUR_USER/bigboysvault
