# Copy to ops/env and fill in. Never commit ops/env (it's in .gitignore). One KEY=value per line; the value is
# read as plain text, so spaces are fine (FLY_API_TOKEN starts with "FlyV1 " and that's right).
SITE=https://www.bigboysvault.com
# The owner's admin password (fly secrets list -a bigboysvault shows it's set; the value is yours).
ADMIN_TOKEN=
FLY_APP=bigboysvault
# For ops/images.sh, ops/deploy.sh and ops/restore-pictures.sh: fly tokens create deploy -a bigboysvault
FLY_API_TOKEN=
# A bucket for copies off the VM (first-run.sh makes one; or: gcloud storage buckets create gs://bbv-backups-XXXX --location=asia-southeast1)
GCS_BUCKET=
# Problems always show on the admin dashboard and bell. To also get a message on your phone:
# a Telegram bot (talk to @BotFather for the token, then get your chat id from @userinfobot)…
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# …or a Discord/Slack-style webhook.
ALERT_WEBHOOK=
# Optional: a fixed admin password for the staging copy (16+ characters). Empty means a new random one each time.
STAGING_ADMIN_TOKEN=

# Leave these out unless you really need another place. Defaults:
#   DATA_DIR  where copies and logs live on this VM: $HOME/bbv
#   REPO_DIR  the code checkout for deploy.sh and staging.sh: the folder above ops/
#   ORIGIN    the site's own Fly address (skips Cloudflare): https://<FLY_APP>.fly.dev
# DATA_DIR=
# REPO_DIR=
# ORIGIN=
