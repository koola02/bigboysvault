# Big Boys Vault jobs. Times are the VM's clock (Asia/Manila). ops/install-cron.sh fills in OPS and LOGS.
# Every job line ends with the same tag, so install-cron.sh can find and replace them. Order each night:
# update the scripts, back up, refresh prices, then make and push WebP/AVIF pictures.
*/5 * * * *  bash OPS/uptime.sh  >> LOGS/uptime.log 2>&1   # bigboysvault/ops
15 2 * * *   bash OPS/update.sh  >> LOGS/update.log 2>&1   # bigboysvault/ops
30 2 * * *   bash OPS/backup.sh  >> LOGS/backup.log 2>&1   # bigboysvault/ops
0 3 * * *    bash OPS/prices.sh  >> LOGS/prices.log 2>&1   # bigboysvault/ops
30 3 * * *   bash OPS/images.sh  >> LOGS/images.log 2>&1   # bigboysvault/ops
*/15 * * * * bash OPS/checks.sh  >> LOGS/checks.log 2>&1   # bigboysvault/ops
*/30 * * * * bash OPS/photos.sh  >> LOGS/photos.log 2>&1   # bigboysvault/ops
15 4 * * *   bash OPS/drill.sh   >> LOGS/drill.log 2>&1    # bigboysvault/ops
45 4 * * *   bash OPS/similar.sh >> LOGS/similar.log 2>&1  # bigboysvault/ops
